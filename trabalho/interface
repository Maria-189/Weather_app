# CARREGAMENTO DE DADOS GEO
# ─────────────────────────────────────────────

def carregar_distritos_local():
    if os.path.exists(FICHEIRO_DIST):
        with open(FICHEIRO_DIST, "r", encoding="utf-8") as f:
            return json.load(f)
    return []

def carregar_municipios_local():
    if os.path.exists(FICHEIRO_MUN):
        with open(FICHEIRO_MUN, "r", encoding="utf-8") as f:
            return json.load(f)
    return []

def carregar_distritos_api():
    try:
        r = requests.get(URL_BASE + "/v1/geo/districts", timeout=8)
        r.raise_for_status()
        dados = r.json().get("data", {}).get("districts", [])
        lista = [{"code": f"{int(d['code']):02d}", "name": d["name"]} for d in dados]
        lista.append({"code": "31", "name": "Região Autónoma da Madeira"})
        lista.append({"code": "32", "name": "Região Autónoma dos Açores"})
        return sorted(lista, key=lambda x: x["name"])
    except:
        return []

def carregar_municipios_api(district_code: str):
    try:
        municipios = []
        offset, limit = 0, 20
        while True:
            r = requests.get(URL_BASE + "/v1/geo/municipalities",
                             params={"offset": offset, "limit": limit}, timeout=8)
            r.raise_for_status()
            lista = r.json().get("data", {}).get("municipalities", [])
            if not lista:
                break
            for item in lista:
                cod = f"{int(item['district_code']):02d}"
                if cod == district_code:
                    municipios.append({"district_code": cod, "name": item["name"]})
            offset += limit
        return sorted(municipios, key=lambda x: x["name"])
    except:
        return []

# ─────────────────────────────────────────────
# WORKER — API PTDATA WEATHER
# ─────────────────────────────────────────────

class WeatherWorker(QThread):
    resultado = Signal(dict)
    erro      = Signal(str)

    def __init__(self, municipio_nome: str, distrito_nome: str):
        super().__init__()
        self.municipio_nome = municipio_nome
        self.distrito_nome  = distrito_nome

    def run(self):
        dados = self._obter_meteorologia_ptdata(self.municipio_nome)
        if dados:
            self.resultado.emit(dados)
        else:
            self.erro.emit("Não foi possível obter dados meteorológicos da API PTData.")

    def _obter_meteorologia_ptdata(self, municipio):
        try:
            params = {
                "municipality": municipio,
                "days": 5,
                "limit": 5
            }

            r = requests.get(
                "https://api.ptdata.org/v1/weather/forecasts",
                params=params,
                timeout=10
            )
            r.raise_for_status()

            forecasts = r.json().get("data", {}).get("forecasts", [])
            if not forecasts:
                return None

            dados = {
                "daily": {
                    "time": [],
                    "weathercode": [],
                    "temperature_2m_max": [],
                    "temperature_2m_min": [],
                    "windspeed_10m_max": [],
                    "precipitation_probability_max": []
                },
                "current_weather": {
                    "temperature": forecasts[0].get("temp_max")
                }
            }

            for f in forecasts:
                dados["daily"]["time"].append(f.get("date"))
                dados["daily"]["weathercode"].append(f.get("weather_code"))
                dados["daily"]["temperature_2m_max"].append(f.get("temp_max"))
                dados["daily"]["temperature_2m_min"].append(f.get("temp_min"))
                dados["daily"]["windspeed_10m_max"].append(f.get("wind_max"))
                dados["daily"]["precipitation_probability_max"].append(f.get("precip_prob"))

            return dados

        except Exception as e:
            print("[ERRO] PTData Weather:", e)
            return None

