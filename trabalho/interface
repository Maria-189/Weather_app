    # ─────────────────────────────────────────────
    # GEO
    # ─────────────────────────────────────────────

    def _carregar_geo(self):
        self._distritos = carregar_distritos_local()
        if not self._distritos:
            self._set_status("A obter distritos da API…")
            self._distritos = carregar_distritos_api()

        self._municipios = carregar_municipios_local()
        if not self._municipios:
            self._set_status("A obter municípios da API…")
            self._municipios = carregar_municipios_api("11")

        self._distritos = sorted(self._distritos, key=lambda d: d["name"])

        self.combo_district.blockSignals(True)
        self.combo_district.clear()
        for d in self._distritos:
            self.combo_district.addItem(d["name"], userData=d["code"])
        self.combo_district.blockSignals(False)

        todos_nomes = [m["name"] for m in self._municipios]
        completer = QCompleter(todos_nomes, self)
        completer.setCaseSensitivity(Qt.CaseSensitivity.CaseInsensitive)
        completer.setFilterMode(Qt.MatchFlag.MatchContains)
        self.search_bar.setCompleter(completer)

        if self._distritos:
            self._on_district_changed(0)

        self._set_status("")

        if self.combo_city.count() > 0:
            self.update_weather()

    def _municipios_do_distrito(self, district_code: str):
        filtrados = [m for m in self._municipios if m.get("district_code") == district_code]
        if not filtrados:
            filtrados = carregar_municipios_api(district_code)
            self._municipios.extend(filtrados)
        return sorted(filtrados, key=lambda m: m["name"])

    def _on_district_changed(self, index):
        if index < 0 or index >= len(self._distritos):
            return
        code = self.combo_district.itemData(index)
        municipios = self._municipios_do_distrito(code)

        self.combo_city.blockSignals(True)
        self.combo_city.clear()
        for m in municipios:
            self.combo_city.addItem(m["name"], userData=m.get("code", ""))
        self.combo_city.blockSignals(False)

    def _on_search(self):
        texto = self.search_bar.text().strip()
        if not texto:
            return
        for m in self._municipios:
            if texto.lower() in m["name"].lower():
                district_code = m.get("district_code", "")
                for i, d in enumerate(self._distritos):
                    if d["code"] == district_code:
                        self.combo_district.setCurrentIndex(i)
                        break
                for j in range(self.combo_city.count()):
                    if self.combo_city.itemText(j).lower() == m["name"].lower():
                        self.combo_city.setCurrentIndex(j)
                        break
                self.update_weather()
                return
        self._set_status(f"Município '{texto}' não encontrado.")

    # ─────────────────────────────────────────────
    # METEOROLOGIA
    # ─────────────────────────────────────────────

    def update_weather(self):
        municipio = self.combo_city.currentText()
        distrito  = self.combo_district.currentText()

        if not municipio:
            return

        self._set_status(f"A obter dados para {municipio}…")
        self.btn_get_weather.setEnabled(False)

        if self._worker and self._worker.isRunning():
            self._worker.terminate()

        self._worker = WeatherWorker(municipio, distrito)
        self._worker.resultado.connect(self._on_weather_ready)
        self._worker.erro.connect(self._on_weather_erro)
        self._worker.start()

    def _on_weather_ready(self, dados: dict):
        self.btn_get_weather.setEnabled(True)
        municipio = self.combo_city.currentText()
        self._set_status(f"Dados actualizados para {municipio}.")

        daily   = dados.get("daily", {})
        current = dados.get("current_weather", {})

        datas   = daily.get("time", []) or []
        codes   = daily.get("weathercode", []) or []
        maxs    = daily.get("temperature_2m_max", []) or []
        mins    = daily.get("temperature_2m_min", []) or []
        winds   = daily.get("windspeed_10m_max", []) or []
        precips = daily.get("precipitation_probability_max", []) or []

        t = current.get("temperature")
        temp_actual = round(t) if isinstance(t, (int, float)) else "--"

        nomes_dias = ["Hoje", "Amanhã", "", "", "", ""]
        semana_pt  = ["Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado", "Domingo"]
        hoje       = datetime.today()
        for i in range(2, 5):
            d = hoje + timedelta(days=i)
            nomes_dias[i] = semana_pt[d.weekday()]

        while self.cards_layout.count():
            child = self.cards_layout.takeAt(0)
            if child.widget():
                child.widget().deleteLater()

        high_vals = []
        low_vals  = []

        for i in range(min(5, len(datas))):
            code_raw = codes[i] if i < len(codes) else None
            code  = code_raw if isinstance(code_raw, int) else 0
            emoji, cond = CONDICAO_ICONS.get(code, ("🌡️", "Unknown"))

            max_raw = maxs[i] if i < len(maxs) else None
            min_raw = mins[i] if i < len(mins) else None
            wind_raw = winds[i] if i < len(winds) else None
            prec_raw = precips[i] if i < len(precips) else None

            high_num = max_raw if isinstance(max_raw, (int, float)) else None
            low_num  = min_raw if isinstance(min_raw, (int, float)) else None
            wind_num = wind_raw if isinstance(wind_raw, (int, float)) else None
            prec_num = prec_raw if isinstance(prec_raw, (int, float)) else None

            high  = round(high_num) if high_num is not None else "--"
            low   = round(low_num)  if low_num is not None else "--"
            wind  = f"{round(wind_num)} km/h" if wind_num is not None else "--"
            prec  = f"{round(prec_num)}%" if prec_num is not None else "--"

            try:
                dt_obj = datetime.strptime(datas[i], "%Y-%m-%d")
                date_str = dt_obj.strftime("%d %b")
            except:
                date_str = datas[i]

            curr_t = temp_actual if i == 0 else high

            card = WeatherCard(
                nomes_dias[i], date_str, cond, emoji,
                curr_t, high, low, wind, prec
            )
            self.cards_layout.addWidget(card)

            high_vals.append(high_num)
            low_vals.append(low_num)

        self._update_chart(datas[:5], high_vals, low_vals)

    def _on_weather_erro(self, mensagem: str):
        self.btn_get_weather.setEnabled(True)
        self._set_status("")
        QMessageBox.warning(self, "Erro", mensagem)

    def _update_chart(self, datas, high_vals, low_vals):
        semana_abrev = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"]

        chart = QChart()
        chart.setBackgroundVisible(False)
        chart.legend().hide()

        high_series = QSplineSeries()
        low_series  = QSplineSeries()

        for i, (h, l) in enumerate(zip(high_vals, low_vals)):
            if isinstance(h, (int, float)):
                high_series.append(QPointF(i, h))
            if isinstance(l, (int, float)):
                low_series.append(QPointF(i, l))

        high_series.setColor(QColor("#f87171"))
        high_series.setPointsVisible(True)
        low_series.setColor(QColor("#60a5fa"))
        low_series.setPointsVisible(True)

        chart.addSeries(high_series)
        chart.addSeries(low_series)

        axis_x = QCategoryAxis()
        for i, data_str in enumerate(datas):
            try:
                dt_obj = datetime.strptime(data_str, "%Y-%m-%d")
                label  = f"{'Hoje' if i == 0 else semana_abrev[dt_obj.weekday()]} ({dt_obj.strftime('%d/%m')})"
            except:
                label = data_str
            axis_x.append(label, i)

        axis_x.setLabelsColor(QColor("#94a3b8"))
        axis_x.setLinePenColor(QColor("#334155"))
        axis_x.setGridLineVisible(False)
        chart.addAxis(axis_x, Qt.AlignmentFlag.AlignBottom)
        high_series.attachAxis(axis_x)
        low_series.attachAxis(axis_x)

        nums = [v for v in (high_vals + low_vals) if isinstance(v, (int, float))]
        if nums:
            y_min = max(0, min(nums) - 3)
            y_max = max(nums) + 3
        else:
            y_min, y_max = 0, 10

        axis_y = QValueAxis()
        axis_y.setRange(y_min, y_max)
        axis_y.setLabelFormat("%d°C")
        axis_y.setLabelsColor(QColor("#94a3b8"))
        axis_y.setLinePenColor(QColor("#334155"))
        axis_y.setGridLinePen(QColor("#1e293b"))
        chart.addAxis(axis_y, Qt.AlignmentFlag.AlignLeft)
        high_series.attachAxis(axis_y)
        low_series.attachAxis(axis_y)

        self.chart_view.setChart(chart)

    def _set_status(self, msg: str):
        self.lbl_status.setText(msg)
        QApplication.processEvents()

