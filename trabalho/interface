import sys
import json
import requests
from datetime import datetime, timedelta
from PySide6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout,
                               QHBoxLayout, QLabel, QComboBox, QPushButton,
                               QLineEdit, QFrame, QGraphicsDropShadowEffect)
from PySide6.QtCore import Qt, QPointF
from PySide6.QtGui import QFont, QColor, QPainter
from PySide6.QtCharts import QChart, QChartView, QSplineSeries, QValueAxis, QCategoryAxis

class WeatherCard(QFrame):
    def __init__(self, day_name, date_str, condition, emoji, current_temp, high_temp, low_temp, wind, precip=None):
        super().__init__()
        self.setObjectName("WeatherCard")
        self.setStyleSheet("""
            QFrame#WeatherCard {
                background-color: #1e293b;
                border: 1px solid #334155;
                border-radius: 12px;
            }
            QLabel { color: #f8fafc; }
        """)
        shadow = QGraphicsDropShadowEffect(self)
        shadow.setBlurRadius(15)
        shadow.setColor(QColor(0, 0, 0, 80))
        shadow.setOffset(0, 4)
        self.setGraphicsEffect(shadow)
        layout = QVBoxLayout(self)
        layout.setSpacing(6)
        layout.setContentsMargins(15, 20, 15, 20)
        lbl_day = QLabel(day_name)
        lbl_day.setFont(QFont("Arial", 11, QFont.Weight.Bold))
        lbl_day.setStyleSheet("color: #94a3b8;")
        lbl_date = QLabel(date_str)
        lbl_date.setFont(QFont("Arial", 9))
        lbl_date.setStyleSheet("color: #64748b;")
        lbl_emoji = QLabel(emoji)
        lbl_emoji.setFont(QFont("Arial", 26))
        lbl_emoji.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lbl_temp = QLabel(f"{current_temp}°C")
        lbl_temp.setFont(QFont("Arial", 18, QFont.Weight.Bold))
        lbl_temp.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lbl_cond = QLabel(condition)
        lbl_cond.setFont(QFont("Arial", 10))
        lbl_cond.setStyleSheet("color: #cbd5e1;")
        lbl_cond.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lbl_range = QLabel(f"↑ {high_temp}°C  ↓ {low_temp}°C")
        lbl_range.setFont(QFont("Arial", 9))
        lbl_range.setStyleSheet("color: #94a3b8;")
        lbl_range.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lbl_wind = QLabel(f"💨 {wind} km/h")
        lbl_wind.setFont(QFont("Arial", 9))
        lbl_wind.setStyleSheet("color: #94a3b8;")
        layout.addWidget(lbl_day)
        layout.addWidget(lbl_date)
        layout.addWidget(lbl_emoji)
        layout.addWidget(lbl_temp)
        layout.addWidget(lbl_cond)
        layout.addWidget(lbl_range)
        layout.addSpacing(10)
        layout.addWidget(lbl_wind)
        if precip is not None:
            lbl_precip = QLabel(f"💧 {precip}%")
            lbl_precip.setFont(QFont("Arial", 9))
            lbl_precip.setStyleSheet("color: #38bdf8;")
            layout.addWidget(lbl_precip)

class DistrictWeatherApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Previsão do Tempo IPMA")
        self.resize(850, 650)
        self.setStyleSheet("QMainWindow { background-color: #0f172a; }")
        self.__distritos_dados = self.__carregar_ficheiro_json("distrito_30Maio2026.json")
        self.__municipios_dados = self.__carregar_ficheiro_json("municipios_30Maio2026.json")
        main_widget = QWidget()
        self.setCentralWidget(main_widget)
        main_layout = QVBoxLayout(main_widget)
        main_layout.setContentsMargins(20, 20, 20, 20)
        main_layout.setSpacing(15)
        controls_layout = QHBoxLayout()
        controls_layout.setSpacing(10)
        self.combo_district = QComboBox()
        self.combo_city = QComboBox()
        self.search_bar = QLineEdit()
        self.search_bar.setPlaceholderText("Filtrar municípios...")
        control_style = """
            QComboBox, QLineEdit {
                background-color: #1e293b;
                border: 1px solid #334155;
                border-radius: 6px;
                padding: 6px 12px;
                color: #f8fafc;
            }
            QComboBox::drop-down { border: none; }
        """
        self.combo_district.setStyleSheet(control_style)
        self.combo_city.setStyleSheet(control_style)
        self.search_bar.setStyleSheet(control_style)
        for dist in self.__distritos_dados:
            self.combo_district.addItem(dist["name"], dist["code"])
        btn_get_weather = QPushButton("Ver Estado do Tempo")
        btn_get_weather.setStyleSheet("""
            QPushButton {
                background-color: #2563eb;
                color: white;
                border-radius: 6px;
                padding: 6px 16px;
                font-weight: bold;
            }
            QPushButton:hover { background-color: #1d4ed8; }
        """)
        controls_layout.addWidget(self.combo_district, 2)
        controls_layout.addWidget(self.search_bar, 2)
        controls_layout.addWidget(self.combo_city, 3)
        controls_layout.addWidget(btn_get_weather, 1)
        main_layout.addLayout(controls_layout)
        self.cards_layout = QHBoxLayout()
        self.cards_layout.setSpacing(12)
        main_layout.addLayout(self.cards_layout)
        self.chart_view = QChartView()
        self.chart_view.setRenderHint(QPainter.RenderHint.Antialiasing)
        self.chart_view.setStyleSheet("background-color: transparent;")
        main_layout.addWidget(self.chart_view)
        self.combo_district.currentIndexChanged.connect(self.__atualizar_combo_cidades)
        btn_get_weather.clicked.connect(self.update_weather)
        self.__atualizar_combo_cidades(0)

    def __carregar_ficheiro_json(self, caminho):
        try:
            with open(caminho, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception as e:
            print(f"[ERRO] Falha ao ler {caminho}: {e}")
            return []

    def __atualizar_combo_cidades(self, index):
        self.combo_city.clear()
        if index < 0 or index >= len(self.__distritos_dados):
            return
        distrito_selecionado = self.__distritos_dados[index]
        codigo_distrito = distrito_selecionado["code"]
        for mun in self.__municipios_dados:
            if mun["district_code"] == codigo_distrito:
                self.combo_city.addItem(mun["name"], mun["code"])

    def update_weather(self):
        while self.cards_layout.count():
            item = self.cards_layout.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()
        id_global_cidade = self.combo_city.currentData()
        if not id_global_cidade:
            return
        token_distrito = id_global_cidade[:2]
        base_api_url = f"https://api.ptdata.org/v1/weather/forecast/daily/{token_distrito}/{id_global_cidade}"
        hoje = datetime.now()
        amanha = hoje + timedelta(days=1)
        depois_amanha = ServerTime = hoje + timedelta(days=2)
        rotulos_dias = ["Hoje", "Amanhã", depois_amanha.strftime("%A")]
        datas_alvo = [hoje.strftime("%Y-%m-%d"), amanha.strftime("%Y-%m-%d"), depois_amanha.strftime("%Y-%m-%d")]
        dados_grafico_high = []
        dados_grafico_low = []
        eixo_x_labels = []
        for i in range(3):
            dia_str = rotulos_dias[i]
            data_iso = datas_alvo[i]
            try:
                resposta = requests.get(base_api_url, params={"date": data_iso}, timeout=10)
                resposta.raise_for_status()
                bloco_resposta = resposta.json()
                previsao = bloco_resposta.get("data", {}).get("forecast", {})
                if not previsao:
                    continue
                t_max = float(previsao.get("tMax", 0))
                t_min = float(previsao.get("tMin", 0))
                t_med = float(previsao.get("tMed", t_min))
                velocidade_vento = previsao.get("classWindSpeed", "N/D")
                prob_precip = previsao.get("precipitaProb", "0")
                descricao = previsao.get("description", "Sem dados")
                emoji = "☀️"
                desc_lower = descricao.lower()
                if "chuva" in desc_lower or "aguaceiros" in desc_lower:
                    emoji = "🌧️"
                elif "nuvens" in desc_lower or "nublado" in desc_lower:
                    emoji = "☁️"
                elif "parcialmente" in desc_lower:
                    emoji = "⛅"
                data_formatada = datetime.strptime(data_iso, "%Y-%m-%d").strftime("%d %b")
                card = WeatherCard(
                    day_name=dia_str,
                    date_str=data_formatada,
                    condition=descricao,
                    emoji=emoji,
                    current_temp=str(int(t_med)),
                    high_temp=str(int(t_max)),
                    low_temp=str(int(t_min)),
                    wind=str(velocidade_vento),
                    precip=str(prob_precip)
                )
                self.cards_layout.addWidget(card)
                dados_grafico_high.append(t_max)
                dados_grafico_low.append(t_min)
                eixo_x_labels.append(f"{dia_str} ({data_formatada})")
            except Exception as e:
                print(f"Erro ao obter dados para {data_iso}: {e}")
        if dados_grafico_high:
            chart = QChart()
            chart.setTitle("Tendência de Temperaturas (Próximos 3 Dias)")
            chart.setTitleFont(QFont("Arial", 11, QFont.Weight.Bold))
            chart.setTitleBrush(QColor("#f8fafc"))
            chart.setBackgroundBrush(QColor("#1e293b"))
            chart.setPlotAreaBackgroundVisible(True)
            chart.setPlotAreaBackgroundBrush(QColor("#111827"))
            high_series = QSplineSeries()
            high_series.setName("Temperatura Máxima")
            low_series = QSplineSeries()
            low_series.setName("Temperatura Mínima")
            for idx in range(len(dados_grafico_high)):
                high_series.append(QPointF(idx, dados_grafico_high[idx]))
                low_series.append(QPointF(idx, dados_grafico_low[idx]))
            high_series.setColor(QColor("#f87171"))
            high_series.setPointsVisible(True)
            low_series.setColor(QColor("#60a5fa"))
            low_series.setPointsVisible(True)
            chart.addSeries(high_series)
            chart.addSeries(low_series)
            axis_x = QCategoryAxis()
            for idx in range(len(eixo_x_labels)):
                axis_x.append(eixo_x_labels[idx], idx)
            axis_x.setLabelsColor(QColor("#94a3b8"))
            axis_x.setLinePenColor(QColor("#334155"))
            axis_x.setGridLineVisible(False)
            chart.addAxis(axis_x, Qt.AlignmentFlag.AlignBottom)
            high_series.attachAxis(axis_x)
            low_series.attachAxis(axis_x)
            axis_y = QValueAxis()
            min_y = min(dados_grafico_low) - 3
            max_y = max(dados_grafico_high) + 3
            axis_y.setRange(min_y, max_y)
            axis_y.setLabelFormat("%d°C")
            axis_y.setLabelsColor(QColor("#94a3b8"))
            axis_y.setLinePenColor(QColor("#334155"))
            axis_y.setGridLinePen(QColor("#334155"))
            chart.addAxis(axis_y, Qt.AlignmentFlag.AlignLeft)
            high_series.attachAxis(axis_y)
            low_series.attachAxis(axis_y)
            self.chart_view.setChart(chart)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = DistrictWeatherApp()
    window.show()
    sys.exit(app.exec())
