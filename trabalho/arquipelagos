def carregar_arquipelagos():
    # Municípios da Madeira (31)
    madeira = [
        "Calheta",
        "Câmara de Lobos",
        "Funchal",
        "Machico",
        "Ponta do Sol",
        "Porto Moniz",
        "Porto Santo",
        "Ribeira Brava",
        "Santa Cruz",
        "Santana",
        "São Vicente"
    ]

    # Municípios dos Açores (32)
    acores = [
        "Angra do Heroísmo",
        "Calheta (São Jorge)",
        "Corvo",
        "Horta",
        "Lagoa",
        "Lajes das Flores",
        "Lajes do Pico",
        "Madalena",
        "Nordeste",
        "Ponta Delgada",
        "Povoação",
        "Praia da Vitória",
        "Ribeira Grande",
        "Santa Cruz da Graciosa",
        "Santa Cruz das Flores",
        "São Roque do Pico",
        "Velas",
        "Vila do Porto",
        "Vila Franca do Campo"
    ]

    lista_final = []

    # Criar códigos DDMM para Madeira
    for i, nome in enumerate(sorted(madeira), start=1):
        lista_final.append({
            "district_code": "31",
            "code": f"31{i:02d}",
            "name": nome
        })

    # Criar códigos DDMM para Açores
    for i, nome in enumerate(sorted(acores), start=1):
        lista_final.append({
            "district_code": "32",
            "code": f"32{i:02d}",
            "name": nome
        })

    return lista_final
