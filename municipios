import requests
from modelos import Municipio
from confi import URL_BASE

ORDEM_DISTRITOS = [
    "01","02","03","04","05","06","07","08","09",
    "10","11","12","13","14","15","16","17","18",
    "31","32"
]

def carregar_municipios():
    ferramenta = Municipio()
    url = URL_BASE + "/v1/geo/municipalities"

    municipios = []
    offset = 0
    limit = 20

    while True:
        try:
            resposta = requests.get(url, params={"offset": offset, "limit": limit})
            resposta.raise_for_status()
        except:
            print("\033[91m[ERRO] Falha ao obter municípios.\033[00m")
            return []

        dados = resposta.json()
        lista = dados.get("data", {}).get("municipalities", [])

        if not lista:
            break

        for item in lista:
            codigo_distrito = f"{int(item['district_code']):02d}"
            municipios.append({
                "district_code": codigo_distrito,
                "name": item["name"]
            })

        offset += limit

    agrupado = {}
    for m in municipios:
        agrupado.setdefault(m["district_code"], []).append(m)

    lista_final = []

    for dist in ORDEM_DISTRITOS:
        if dist not in agrupado:
            continue

        lista_ordenada = sorted(agrupado[dist], key=lambda x: x["name"])
        contador = 1

        for item in lista_ordenada:
            codigo_mm = f"{contador:02d}"
            codigo_final = dist + codigo_mm

            lista_final.append({
                "district_code": dist,
                "code": codigo_final,
                "name": item["name"]
            })
            contador += 1

    return lista_final
