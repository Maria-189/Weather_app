import json
import os
import requests

URL_BASE = "https://api.ptdata.org"
URL = URL_BASE + "/v1/geo/districts"
FICHEIRO_JSON = "meteriologia_30Maio2026.json"

class GestorEstruturaJSON:
    def __init__(self, nome_arquivo: str = FICHEIRO_JSON):
        self.nome_arquivo = nome_arquivo
        caminho_absoluto = os.path.abspath(self.nome_arquivo)
        print(f"[DEBUG] A procurar ficheiro em: {caminho_absoluto}")

        try:
            if not os.path.exists(self.nome_arquivo):
                print("\033[91m[AVISO] O ficheiro não existe.\033[00m")
                # Inicializa com lista vazia (array top-level)
                self._escrever_arquivo([])
                print(f"\033[93m[INFO] Ficheiro JSON inicializado em: {caminho_absoluto}\033[00m")
            else:
                print(f"\033[92m[OK] Ficheiro encontrado: {caminho_absoluto}\033[00m")
        except OSError as e:
            print(f"\033[91m[ERRO] Problema ao aceder ao ficheiro: {e}\033[00m")

    def _escrever_arquivo(self, dados):
        try:
            with open(self.nome_arquivo, "w", encoding="utf-8") as f:
                json.dump(dados, f, indent=4, ensure_ascii=False)
        except OSError as e:
            print(f"\033[91m[ERRO] Não foi possível escrever o ficheiro: {e}\033[00m")

    def gravar_distritos(self, distritos: list):
        # Grava a lista diretamente como array top-level
        self._escrever_arquivo(distritos)
        print(f"\033[92m[OK] Gravados {len(distritos)} distritos em: {os.path.abspath(self.nome_arquivo)}\033[00m")


def obter_distritos_reduzidos(url: str = URL):
    try:
        resposta = requests.get(url, params={})
        resposta.raise_for_status()
    except requests.RequestException as e:
        print(f"\033[91m[ERRO] Falha na requisição: {e}\033[00m")
        return None

    try:
        dados = resposta.json()
    except ValueError:
        print("\033[91m[ERRO] Resposta não é JSON válido.\033[00m")
        return None

    lista = dados.get("data", {}).get("districts")
    if lista is None:
        print("\033[91m[ERRO] Estrutura inesperada: 'data.districts' não encontrada.\033[00m")
        return None

    reduzidos = []
    for item in lista:
        code = item.get("code")
        name = item.get("name")
        if code is not None and name is not None:
            reduzidos.append({"code": code, "name": name})
    return reduzidos


if __name__ == "__main__":
    gestor = GestorEstruturaJSON()
    distritos = obter_distritos_reduzidos()
    if distritos is not None:
        for d in distritos:
            print(f"{d['code']} - {d['name']}")
        gestor.gravar_distritos(distritos)
