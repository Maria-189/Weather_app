import json
import os
import requests

URL_BASE = "https://api.ptdata.org"
FICHEIRO_DIST = "distrito_30Maio2026.json"
FICHEIRO_MUN = "municipios_30Maio2026.json"

# ==========================================
# 1. GESTOR DE FICHEIROS
# ==========================================
class GestorFicheiro:
    def __init__(self, nome_arquivo: str):
        self.nome_arquivo = nome_arquivo

    def verificar_ficheiro(self):
        # Verifica se o ficheiro existe no computador
        return os.path.exists(self.nome_arquivo)

    def ler_ficheiro(self):
        if not self.verificar_ficheiro():
            return None
        try:
            with open(self.nome_arquivo, "r", encoding="utf-8") as f:
                return json.load(f)
        except:
            return None

    def escrever_ficheiro(self, dados):
        with open(self.nome_arquivo, "w", encoding="utf-8") as f:
            json.dump(dados, f, indent=4, ensure_ascii=False)

    def atualizar_ficheiro(self, novos_dados):
        # Verifica se o que está no ficheiro é igual aos novos dados
        conteudo_antigo = self.ler_ficheiro()

        if conteudo_antigo == novos_dados:
            print(f"\033[93m[INFO] O ficheiro {self.nome_arquivo} já estava atualizado.\033[00m")
        else:
            self.escrever_ficheiro(novos_dados)
            print(f"\033[92m[OK] Ficheiro {self.nome_arquivo} atualizado com novos dados.\033[00m")


# ==========================================
# 2. CLASSES DOS DADOS (DISTRITO E MUNICIPIO)
# ==========================================
class RegiaoAdministrativa:
    def __init__(self, code: str, name: str):
        self.code = code
        self.name = name


class Distrito(RegiaoAdministrativa):
    def __init__(self, code: str, name: str):
        # Formata o código para ter sempre 2 dígitos (ex: "01")
        codigo_formatado = f"{int(code):02d}"
        super().__init__(codigo_formatado, name)

    def obter_distritos(self):
        # Vai buscar os distritos à API externa
        url = URL_BASE + "/v1/geo/districts"
        try:
            resposta = requests.get(url)
            resposta.raise_for_status()
        except:
            print("\033[91m[ERRO] Falha ao obter distritos.\033[00m")
            return []

        dados = resposta.json()
        lista = dados.get("data", {}).get("districts", [])
        
        # Cria uma lista de dicionários simples para o JSON
        return [{"code": f"{int(d['code']):02d}", "name": d["name"]} for d in lista]


class Municipio(RegiaoAdministrativa):
    def __init__(self, code: str = "", name: str = "", district_code: str = ""):
        super().__init__(code, name)
        self.district_code = district_code

    def obter_municipios(self):
        # Vai buscar os municípios com a lógica do OFFSET (igual ao teu código)
        url = URL_BASE + "/v1/geo/municipalities"
        municipios = []
        offset = 0
        limit = 20

        while True:
            try:
                resposta = requests.get(url, params={"offset": offset, "limit": limit})
                resposta.raise_for_status()
            except:
                print("\033[91m[ERRO] Falha ao obter municípios.\033[00m")
                return []

            dados = resposta.json()
            lista = dados.get("data", {}).get("municipalities", [])

            if not lista:
                break

            for item in lista:
                codigo_distrito = f"{int(item['district_code']):02d}"
                municipios.append({
                    "district_code": codigo_distrito,
                    "name": item["name"]
                })

            offset += limit

        # Agrupar e ordenar (a tua lógica oficial)
        agrupado = {}
        for m in municipios:
            dist = m["district_code"]
            if dist not in agrupado:
                agrupado[dist] = []
            agrupado[dist].append(m)

        ordem_distritos = ["01","02","03","04","05","06","07","08","09","10","11","12","13","14","15","16","17","18","31","32"]
        lista_final = []

        for dist in ordem_distritos:
            if dist not in agrupado:
                continue

            lista_ordenada = sorted(agrupado[dist], key=lambda x: x["name"])
            contador = 1

            for item in lista_ordenada:
                codigo_mm = f"{contador:02d}"
                codigo_final = dist + codigo_mm

                lista_final.append({
                    "district_code": dist,
                    "code": codigo_final,
                    "name": item["name"]
                })
                contador += 1

        return lista_final


# ==========================================
# 3. EXECUÇÃO DO PROGRAMA
# ==========================================
if __name__ == "__main__":
    # Criamos os gestores para cada ficheiro
    gestor_distritos = GestorFicheiro(FICHEIRO_DIST)
    gestor_municipios = GestorFicheiro(FICHEIRO_MUN)

    # Instâncias das classes para usar os métodos
    ferramenta_distrito = Distrito("0", "")
    ferramenta_municipio = Municipio()

    # 1. Tratar dos Distritos
    print("A carregar distritos...")
    dados_distritos = ferramenta_distrito.obter_distritos()
    if dados_distritos:
        gestor_distritos.atualizar_ficheiro(dados_distritos)

    # 2. Tratar dos Municípios
    print("A carregar municípios...")
    dados_municipios = ferramenta_municipio.obter_municipios()
    if dados_municipios:
        gestor_municipios.atualizar_ficheiro(dados_municipios)
