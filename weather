import json
import os
import requests

URL_BASE = "https://api.ptdata.org"
URL = URL_BASE + "/v1/geo/districts"
FICHEIRO_JSON = "distrito_30Maio2026.json"
FICHEIRO_MUN = "municipios_30Maio2026.json"

class GestorCidades:
    def __init__(self, nome_arquivo: str = FICHEIRO_JSON):
        self.__nome_arquivo = nome_arquivo
        caminho_absoluto = os.path.abspath(self.__nome_arquivo)

        print(f"[DEBUG] A procurar ficheiro em: {caminho_absoluto}")

        if not os.path.exists(self.__nome_arquivo):
            print("\033[91m[AVISO] O ficheiro não existe.\033[00m")
            self.__escrever_arquivo([])
            print("\033[93m[INFO] Ficheiro JSON criado e inicializado.\033[00m")
        else:
            print("\033[92m[OK] Ficheiro encontrado.\033[00m")

    def __ler_arquivo(self):
        if not os.path.exists(self.__nome_arquivo):
            return None
        try:
            with open(self.__nome_arquivo, "r", encoding="utf-8") as f:
                return json.load(f)
        except:
            return None

    def __escrever_arquivo(self, dados):
        with open(self.__nome_arquivo, "w", encoding="utf-8") as f:
            json.dump(dados, f, indent=4, ensure_ascii=False)

    def gravar_distritos(self, distritos: list):
        conteudo_antigo = self.__ler_arquivo()

        if conteudo_antigo == distritos:
            print("\033[93m[INFO] O ficheiro já estava atualizado. Nada foi alterado.\033[00m")
        else:
            self.__escrever_arquivo(distritos)
            print("\033[92m[OK] Ficheiro atualizado com novos dados.\033[00m")


def obter_distritos_reduzidos(url: str = URL):
    try:
        resposta = requests.get(url)
        resposta.raise_for_status()
    except:
        print("\033[91m[ERRO] Falha ao obter distritos.\033[00m")
        return None

    dados = resposta.json()
    lista = dados.get("data", {}).get("districts", [])

    # ⭐ FORMATAR CÓDIGO DO DISTRITO PARA 2 DÍGITOS
    return [{"code": f"{int(d['code']):02d}", "name": d["name"]} for d in lista]


# ⭐⭐ FUNÇÃO FINAL: OFFSET + ORDEM DOS DISTRITOS + CÓDIGO DDMM ⭐⭐
def obter_municipios_por_distrito():
    url = URL_BASE + "/v1/geo/municipalities"

    municipios = []
    offset = 0
    limit = 20

    # Buscar todos os municípios com OFFSET
    while True:
        try:
            resposta = requests.get(url, params={"offset": offset, "limit": limit})
            resposta.raise_for_status()
        except:
            print("\033[91m[ERRO] Falha ao obter municípios.\033[00m")
            return None

        dados = resposta.json()
        lista = dados.get("data", {}).get("municipalities", [])

        if not lista:
            break

        for item in lista:
            codigo_distrito = f"{int(item['district_code']):02d}"

            municipios.append({
                "district_code": codigo_distrito,
                "name": item["name"]
            })

        offset += limit

    # AGRUPAR POR DISTRITO
    agrupado = {}
    for m in municipios:
        dist = m["district_code"]
        if dist not in agrupado:
            agrupado[dist] = []
        agrupado[dist].append(m)

    # ⭐ ORDEM OFICIAL DOS DISTRITOS (a que enviaste)
    ordem_distritos = [
        "01","02","03","04","05","06","07","08","09",
        "10","11","12","13","14","15","16","17","18",
        "31","32"
    ]

    resultado = {}

    # ⭐ PARA CADA DISTRITO, ORDENAR MUNICÍPIOS E GERAR CÓDIGO DDMM
    for dist in ordem_distritos:
        if dist not in agrupado:
            continue

        lista = sorted(agrupado[dist], key=lambda x: x["name"])

        nova_lista = []
        contador = 1

        for item in lista:
            codigo_mm = f"{contador:02d}"     # 01, 02, 03...
            codigo_final = dist + codigo_mm   # DDMM → 0201

            nova_lista.append({
                "district_code": dist,
                "code": codigo_final,
                "name": item["name"]
            })

            contador += 1

        resultado[dist] = nova_lista

    return resultado


def gravar_municipios_separado(municipios: dict, nome_arquivo=FICHEIRO_MUN):
    lista_final = []

    for dist_code, lista in municipios.items():
        for m in lista:
            lista_final.append({
                "district_code": dist_code,
                "code": m["code"],
                "name": m["name"]
            })

    # Verificar se já existe e se está igual
    if os.path.exists(nome_arquivo):
        with open(nome_arquivo, "r", encoding="utf-8") as f:
            antigo = json.load(f)
        if antigo == lista_final:
            print("\033[93m[INFO] O ficheiro de municípios já estava atualizado.\033[00m")
            return

    with open(nome_arquivo, "w", encoding="utf-8") as f:
        json.dump(lista_final, f, indent=4, ensure_ascii=False)

    print(f"\033[92m[OK] Gravados {len(lista_final)} municípios em: {os.path.abspath(nome_arquivo)}\033[00m")


# MAIN FINAL
if __name__ == "__main__":
    gestor = GestorCidades()

    distritos = obter_distritos_reduzidos()
    municipios_por_distrito = obter_municipios_por_distrito()

    # Criar JSON só de municípios
    if municipios_por_distrito:
        gravar_municipios_separado(municipios_por_distrito)

    # Criar ficheiro de distritos SEM municípios
    distritos_sem_municipios = []
    for d in distritos:
        distritos_sem_municipios.append({
            "code": d["code"],
            "name": d["name"]
        })

    gestor.gravar_distritos(distritos_sem_municipios)
